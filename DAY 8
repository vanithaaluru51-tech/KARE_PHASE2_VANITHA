// to Reverse the given Number
// I/P                         O/P
// 5                          50 40 30 20 10
// 10 20 30 40  50
// 0  1   2  3   4
import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner obj = new Scanner(System.in);
        int n = obj.nextInt();
        int arr[] = new int[n];
        int i;
        for(i=0;i<n;i++)
        arr[i]=obj.nextInt();
        int s=0;
        int e=n-1;
        while(s<e)
    {
    int temp=arr[s];
    arr[s]=arr[e];
    arr[e]=temp;
    s++;
    e--;
    }
    for(i=0;i<n;i++)
    System.out.print(arr[i]+" ");

}
}
