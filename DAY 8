// Write java program to find the odd&even element count in the array
// I/P                      O/P
//  5 
// 10 2 34 5 23            Odd element count:2
//                         Even element count:3 
    import java.util.*;
    public class Main{
        public static void main(String[] args){
            Scanner obj = new Scanner(System.in);
            int n = obj.nextInt();
            int arr[] = new int[n];
            int i,ec=0,oc=0;
            for(i=0;i<n;i++){
            arr[i]=obj.nextInt();
            if(arr[i]%2==0)
            ec++;
            else
            oc++;
            }
            System.out.println("Even Element count"+ ec++);
            System.out.println("Odd Element count"+ oc++);
        }
    }
