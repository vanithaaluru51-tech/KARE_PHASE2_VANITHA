4.// to count even,odd digits in the given number
import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner obj = new Scanner(System.in);
        int n = obj.nextInt();
        int d,evencount=0,oddcount=0;
        while(n!=0){
            d=n%10;
            if(d%2==0)
            evencount++;
            else
            oddcount++;
            n=n/10;
        }
        System.out.print("Odd digit count" +oddcount);
        System.out.print("Even digit count" +evencount);
        }
    }

5.// to count the prime  digits in the given number
import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner obj = new Scanner(System.in);
        int n = obj.nextInt();
        int c=0,d;
        while(n!=0){
            d=n%10;
            if(d==2||d==3||d==5||d==7)
            c++;
            n=n/10;
        }
        System.out.println("prime digit count:" +c);
    }
}

// write a java program to find the given number is palindrome or not 
import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner obj = new Scanner(System.in);
        int n = obj.nextInt();
        int temp = n,d,rev=0;
        while(n!=0){
            d=n%10;
            rev= rev*10+d;
            n= n/10;
        }
        if(temp==rev)
        System.out.println("Palindrome Number");
        else
        System.out.println("Not a Palindrome Number"); 
    }
}
// HARSHAD NUMBER
import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner obj = new Scanner(System.in);
        int n = obj.nextInt();
        int temp = n;
        int sum=0,d;
        while(n!=0){
            d=n%10;
            sum=sum+d;
            n= n/10;
        }
        if(temp%sum==0)
        System.out.println("HARSHAD NUMBER");
        else
        System.out.println("NOT A HARSHAD NUMBER"); 
    }
}

// NEON NUMBER
import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner obj = new Scanner(System.in);
        int n = obj.nextInt();
        int square = n*n;
        int sum=0,d;
        while(square!=0){
            d=square%10;
            sum=sum+d;
            square= square/10;
        }
        if(sum==n)
        System.out.println("NEON NUMBER");
        else
        System.out.println("NOT A NEON NUMBER"); 
    }
}
