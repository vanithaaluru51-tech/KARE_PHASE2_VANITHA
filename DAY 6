1.// to count a number of digits in the given number
import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner obj = new Scanner(System.in);
        int n = obj.nextInt();
        int c=0;
        while(n!=0){
            n=n/10;
            c++;
        }
        System.out.print("Number of digits" +c);
        }
    }

2.// to reverse the given number
import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner obj = new Scanner(System.in);
        int n = obj.nextInt();
        int d,ans=0;
        while(n!=0){
            d=n%10;
            ans=ans*10+d;
            n=n/10;
        }
        System.out.print("Reverse Number" +ans);
        }
    }

