//INHERITANCE
class Father{
    void gen2()
    {
        System.out.println("Gold");
    }
}
class Son extends Father{
    void gen3(){
        System.out.println("Diamond");
    }
}
class Main{
    public static void main(String[] args){
        Son obj=new Son();
        Father f = new Father();
        f.gen2();
       // f.gen3();
       obj.gen3();
       obj.gen2();
    }
}
