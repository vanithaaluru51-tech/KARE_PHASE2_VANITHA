//Write a java program to check whether the specific number is perfect square or not by using function with no argument,no return type
import java.util.*;
class Main{
    void ps(){
        Scanner obj = new Scanner(System.in);
        int n=obj.nextInt();
        int flag=0,i;
        for(i=1;i<=n/2;i++){
            if(i*i==n){
                flag=1;
            System.out.print("Perfect Square");
            break;
        }
    }
    if(flag==0)
    System.out.print("Not a Perfect Square");
}
public static void main(String[] args){
    Main m=new Main();
    m.ps();
}
}
