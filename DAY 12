//Write a java program to check whether the specific number is perfect square or not by using function with no argument,no return type
import java.util.*;
class Main{
    void ps(){
        Scanner obj = new Scanner(System.in);
        int n=obj.nextInt();
        int flag=0,i;
        for(i=1;i<=n/2;i++){
            if(i*i==n){
                flag=1;
            System.out.print("Perfect Square");
            break;
        }
    }
    if(flag==0)
    System.out.print("Not a Perfect Square");
}
public static void main(String[] args){
    Main m=new Main();
    m.ps();
}
}
//Write a java program to check whether the given number is power of 2 or not by using function with  argument,no return type
import java.util.*;
class Main{
    void powerof2(int a){
        while(a%2==0){
            a=a/2;
        }
        if(a==1)
        System.out.print("Power of 2");
        else
        System.out.print("Not a Power of 2");
    }
    public static void main(String[] args){
        Scanner obj = new Scanner(System.in);
        int n=obj.nextInt();
        Main m=new Main();
        m.powerof2(n);
    }
}
