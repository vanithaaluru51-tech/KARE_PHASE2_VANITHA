// SMALLEST OF THREE NUMBERS
package CSE;
import java.util.*;
public class MAIN {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int a,b,c;
		a = sc.nextInt();
		b = sc.nextInt();
		c = sc.nextInt();
		if(a < b && a < c)
			System.out.print(a + " is Smallest");
		else if(b < c)
			System.out.print(b + " is Smallest");
		else
			System.out.print(c + " is Smallest");
	}
}

