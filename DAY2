// TO FIND THE NUMBER EVEN OR ODD
package CSE;
import java.util.*;
public class MAIN {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int a = sc.nextInt();
		if(a % 2==0)
			System.out.println("Even Number");
		else
			System.out.println("Odd Number");
	}
}

