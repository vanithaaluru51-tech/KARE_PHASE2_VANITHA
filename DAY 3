// WRITE A JAVA PROGRAM TO FIND THE SUM OF EVEN NUMBERS FROM 1 TO N
// i/p                 o/p
// 10                  30
// 6                   12
import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int sum = 0;
        for(int i = 1; i <= n; i++) {
            if(i % 2 == 0)
                sum = sum + i;
        }
        System.out.print(sum);
    }
}

