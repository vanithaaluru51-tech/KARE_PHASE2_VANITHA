//  1                CSE
//  2                ECE
//  3                EEE
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        switch(n){
            case 1:
                System.out.print("CSE");
                break;
            case 2:
                System.out.print("ECE");
                break;
            case 3:
                System.out.print("EEE");
                break;
                default:
                System.out.print("In Valid");
        }
    }
}

