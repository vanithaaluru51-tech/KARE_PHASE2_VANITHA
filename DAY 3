// WRITE A JAVA PROGRAM TO PRINT ODD NUMBERS FROM 1 TO N
// i/p                 o/p
// 10                  1 3 5 7 9
import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        for(int i = 1; i <= n; i++) {
            if(i % 2 != 0)
                System.out.print(i + " ");
        }
    }
}

