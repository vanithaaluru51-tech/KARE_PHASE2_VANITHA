//Order of parameters
import java.util.*;
class Main{
    void print(int a,float b){
        System.out.println(a+" "+b);
    }
    void print(float a,int b){
        System.out.println(a+" "+b);
    }
    void print(char c,double d){
        System.out.println(c+" "+d);
    }
    void print(double c,char d){
        System.out.println(c+" "+d);
    }
    public static void main(String[] args){
        Scanner obj = new Scanner(System.in);
        int a = obj.nextInt();
        float b= obj.nextFloat();
        char c=obj.next().charAt(0);
        double d=obj.nextDouble();
        Main m = new Main();
        m.print(a,b);
        m.print(b,a);
        m.print(c,d);
        m.print(d,c);
        
    }
}

// CONSTRUCTOR OVERLOADING
public class Main {
    int a;
    int b;
    Main() {
        a = 10;
        b = 20;
    }
    Main(int x) {
        a = x;
        b = 30;
    }
    Main(int x, int y) {
        a = x;
        b = y;
    }
    void display() {
        System.out.println(a + " " + b);
    }
    public static void main(String[] args) {
        Main obj1 = new Main();
        obj1.display();
        Main obj2 = new Main(50);
        obj2.display();
        Main obj3 = new Main(60, 70);
        obj3.display();
    }
}

