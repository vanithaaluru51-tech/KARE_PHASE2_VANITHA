// PRIME NUMBER WITHIN A CERTAIN RANGE
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n1 = sc.nextInt();
        int n2 = sc.nextInt();
        int c,i,j;
        for(j = n1; j<=n2; j++){
            c=0;
            for(i = 2; i <= j/2; i++){
                if(j%i==0){
                c++;
                break;}
            }
            if(c==0)
            System.out.print(j + " ");
        }
    }
}

