// ADAM NUMBER
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int sn = n*n;
        int rn=0,srn,ans=0,d;
        while(n!=0){
            d = n%10;
            rn = rn*10+d;
            n=n/10;
        }
        srn = rn * rn;
        while(srn!=0){
            d=srn%10;
            ans=ans*10+d;
            srn=srn/10;
        }
        if(sn == ans)
        System.out.print("Adam Number");
        else
        System.out.print("Not a adam number");
    }
}

