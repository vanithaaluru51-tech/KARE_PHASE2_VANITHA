// SPY NUMBER
// If sum of digits = product of digits, it is a Spy Number.
// i/p                  o/p
// 1124                 Spy Number
// 123                  Not a Spy Number
import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int sum = 0;
        int product = 1;
        int d;
        while(n != 0) {
            d = n % 10;
            sum = sum + d;
            product = product * d;
            n = n / 10;
        }
        if(sum == product)
            System.out.print("Spy Number");
        else
            System.out.print("Not a Spy Number");
    }
}

