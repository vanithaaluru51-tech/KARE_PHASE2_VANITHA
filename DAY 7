// ARMSTRONG NUMBER
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int temp = n, c=0;
        int sum=0,d;
        while(n!=0){
            n=n/10;
            c++;
        }
        n=temp;
        while(n!=0){
            d=n%10;
            sum=sum+(int)Math.pow(d,c);
            n=n/10;
        }
        if(temp==sum)
        System.out.print("Armstrong Number");
        else
        System.out.print("Not a armstrong number");
    }
}

