// DISARIUM NUMBER
// i/p                  o/p
// 135                  Disarium Number
// 123                  Not a Disarium Number
import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int temp = n;
        int c = 0;
        int d, sum = 0;
        while(n != 0) {
            n = n / 10;
            c++;
        }
        n = temp;
        while(n != 0) {
            d = n % 10;
            sum = sum + (int)Math.pow(d, c);
            c--;
            n = n / 10;
        }
        if(temp == sum)
            System.out.print("Disarium Number");
        else
            System.out.print("Not a Disarium Number");
    }
}

