        int c=0,flag=0,i;
        if(n==1){
            System.out.print("Neither prime nor composite");
            return;
        }
        for(i = 2; i <= n/2; i++){
            if(n%i==0){
                c++;
                flag=1;
                System.out.print("Not a Prime Number");
            }
        }
        if(flag==0)
        System.out.print("Prime Number");
    }
}

