// BUZZ NUMBER
// A number is a Buzz Number if it is divisible by 7 or ends with 7.
// i/p                  o/p
// 14                   Buzz Number
// 27                   Not a Buzz Number
// 35                   Buzz Number
import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        if(n % 7 == 0 || n % 10 == 7)
            System.out.print("Buzz Number");
        else
            System.out.print("Not a Buzz Number");
    }
}

