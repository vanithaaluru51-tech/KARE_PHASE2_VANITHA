// HAPPY NUMBER
// i/p                  o/p
// 19                   Happy Number
// 2                    Not a Happy Number
import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        while(n != 1 && n != 4) {
            int sum = 0;
            int d;
            while(n != 0) {
                d = n % 10;
                sum = sum + d * d;
                n = n / 10;
            }
            n = sum;
        }
        if(n == 1)
            System.out.print("Happy Number");
        else
            System.out.print("Not a Happy Number");
    }
}
