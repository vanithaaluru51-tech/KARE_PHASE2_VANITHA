//Print N

import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner obj = new Scanner(System.in);
        int n = obj.nextInt();
        int row,col;
        for(row=0;row<n;row++,System.out.println()){
            for(col=0;col<n;col++){
                if(col==0||col==n-1||row==col)
                System.out.print("N");
                else
                System.out.print(" ");
            }
        }
    }
}
