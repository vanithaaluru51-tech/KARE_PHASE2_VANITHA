            d=sc.nextInt();
        }
        m.display();
    }
    Node first = null;
    void insert(int d){
        Node n = new Node(d);
        if(first==null){
            first = n;
            n.next=first;
            n.prev = first;
        }else{
            Node temp = first;
            while(temp.next != first)
                temp = temp.next;
            temp.next = n;
            n.prev = temp;
            n.next = first;
            first.prev = n;
        }
    }
    void display(){
        if(first == null)
            System.out.println("List is empty");
        Node temp = first;
        do{
            System.out.print(temp.data + " ");
            temp = temp.next;
        }while(temp!=first);
    }
