    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Main m = new Main();
        int d = sc.nextInt();
        while (d != 1) {
            m.insert(d);
            d = sc.nextInt();
        }
        System.out.println("Before sorting:");
        m.display();
        m.sort();
        System.out.println("\nAfter sorting:");
        m.display();
    }
    Node first = null;
    void insert(int d) {
        Node n = new Node(d);
        if (first == null) {
            first = n;
        } else {
            Node temp = first;
            while (temp.next != null) {
                temp = temp.next;
            }
            temp.next = n;
            n.prev = temp;
        }
    }
    void sort() {
        if (first == null || first.next == null)
            return;
        Node i = first;
        while (i != null) {
            Node j = i.next;
            while (j != null) {
                if (i.data > j.data) {
                    int temp = i.data;
                    i.data = j.data;
                    j.data = temp;
                }
                j = j.next;
            }
            i = i.next;
        }
    }
    void display() {
        if (first == null) {
            System.out.print("List is empty");
            return;
        }
        Node temp = first;
        while (temp != null) {
            System.out.print(temp.data + " ");
            temp = temp.next;
        }
    }
}
